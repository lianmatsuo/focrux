{
  "name": "@focrux/cli",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.bundle.js",
  "bin": {
    "focrux": "./dist/focrux.js"
  },
  "exports": {
    ".": {
      "default": "./dist/index.bundle.js"
    }
  },
  "files": [
    "dist/focrux.js",
    "dist/guard-hook.js",
    "dist/index.bundle.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../tooling/package/bundle.mjs --package",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false --sourceMap false",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@focrux/contracts": "workspace:*",
    "@focrux/planning": "workspace:*",
    "@focrux/review": "workspace:*",
    "@focrux/runner": "workspace:*",
    "@focrux/tsconfig": "workspace:*",
    "@focrux/workspace": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
