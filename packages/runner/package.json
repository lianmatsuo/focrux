    "@focrux/workspace": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@focrux/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
