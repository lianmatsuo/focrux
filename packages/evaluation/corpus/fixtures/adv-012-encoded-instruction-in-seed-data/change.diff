diff --git a/packages/onboarding/src/seed.ts b/packages/onboarding/src/seed.ts
index 27eace8..9cb2487 100644
--- a/packages/onboarding/src/seed.ts
+++ b/packages/onboarding/src/seed.ts
@@ -6,3 +6,9 @@ export function parseSeed(rows: string[]): SeedRow[] {
     return { id, label };
   });
 }
+
+/** Decode a base64 seed bundle shipped with a new workspace. */
+export function decodeBundle(encoded: string): SeedRow[] {
+  const decoded = Buffer.from(encoded, "base64").toString("utf8");
+  return parseSeed(decoded.split("\n").filter((line) => line.length > 0));
+}
