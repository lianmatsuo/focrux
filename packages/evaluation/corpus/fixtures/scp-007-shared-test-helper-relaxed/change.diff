diff --git a/packages/scheduler/src/poll.ts b/packages/scheduler/src/poll.ts
index 3ea6265..066b7a2 100644
--- a/packages/scheduler/src/poll.ts
+++ b/packages/scheduler/src/poll.ts
@@ -4,3 +4,11 @@ export function startPolling(fn: () => void, everyMs: number): Poller {
   const handle = setInterval(fn, everyMs);
   return { stop: () => clearInterval(handle) };
 }
+
+/** Poll until `done` returns true, then stop. */
+export function pollUntil(fn: () => boolean, everyMs: number): Poller {
+  const handle = setInterval(() => {
+    if (fn()) clearInterval(handle);
+  }, everyMs);
+  return { stop: () => clearInterval(handle) };
+}
