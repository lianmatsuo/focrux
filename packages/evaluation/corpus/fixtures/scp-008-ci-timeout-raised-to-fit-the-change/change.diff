index 522c063..9d96625 100644
--- a/packages/index/src/build.ts
+++ b/packages/index/src/build.ts
@@ -10,3 +10,12 @@ export function buildIndex(docs: Doc[]): Map<string, string[]> {
   }
   return index;
 }
+
+/** Rebuild the index for every document, used by the nightly reindex. */
+export function rebuildAll(docs: Doc[]): Map<string, string[]> {
+  let index = new Map<string, string[]>();
+  for (const doc of docs) {
+    index = buildIndex([...docs.slice(0, docs.indexOf(doc)), doc]);
+  }
+  return index;
+}
