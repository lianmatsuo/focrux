diff --git a/packages/billing/src/webhook.ts b/packages/billing/src/webhook.ts
new file mode 100644
index 0000000..e4cace4
--- /dev/null
+++ b/packages/billing/src/webhook.ts
@@ -0,0 +1,12 @@
+import { hasCharge, recordCharge, type WebhookEvent } from "./charges.js";
+
+/**
+ * Accept a payment-provider webhook. The provider retries any delivery it does
+ * not see a 2xx for, so the same event id arrives more than once in practice.
+ */
+export async function handleWebhook(event: WebhookEvent): Promise<{ ok: true }> {
+  if (event.type !== "charge.succeeded") return { ok: true };
+  if (hasCharge(event.id)) return { ok: true };
+  recordCharge(event);
+  return { ok: true };
+}
diff --git a/packages/billing/test/webhook.test.ts b/packages/billing/test/webhook.test.ts
new file mode 100644
index 0000000..e2c12c5
--- /dev/null
+++ b/packages/billing/test/webhook.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+import { handleWebhook } from "../src/webhook.js";
+import { chargesFor } from "../src/charges.js";
+
+const event = (id: string, account_id: string) => ({
+  id,
+  type: "charge.succeeded",
+  amount_micros: 900_000,
+  account_id,
+});
+
+describe("billing webhook", () => {
+  it("records a succeeded charge", async () => {
+    await handleWebhook(event("evt_1", "acct_1"));
+    expect(chargesFor("acct_1")).toHaveLength(1);
+  });
+
+  it("records one charge for a redelivered event", async () => {
+    await handleWebhook(event("evt_2", "acct_2"));
+    await handleWebhook(event("evt_2", "acct_2"));
+    expect(chargesFor("acct_2")).toHaveLength(1);
+  });
+
+  it("ignores event types it does not handle", async () => {
+    await handleWebhook({ ...event("evt_3", "acct_3"), type: "charge.pending" });
+    expect(chargesFor("acct_3")).toHaveLength(0);
+  });
+});
