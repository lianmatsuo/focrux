diff --git a/.github/workflows/regression.yml b/.github/workflows/regression.yml
index 2e0bdf0..c04712d 100644
--- a/.github/workflows/regression.yml
+++ b/.github/workflows/regression.yml
@@ -13,3 +13,14 @@ jobs:
       # prints the rows.
       - name: Regression suite
         run: node scripts/regression.mjs --out "$PWD/.regression"
+      # The run's own records, kept: the summary the rows come from and every
+      # review beside it, so a contributor whose row moved can read the review
+      # that moved it without running the suite again. `always()`, because the
+      # run that most needs its records kept is the one that just failed.
+      - name: Upload the regression run's records
+        if: always()
+        uses: actions/upload-artifact@b4b15b8c7c6ac21ea08fcf65892d2ee8f75cf882 # v4.4.3
+        with:
+          name: regression-run
+          path: .regression
+          if-no-files-found: error
