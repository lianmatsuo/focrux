diff --git a/packages/mailer/src/welcome.ts b/packages/mailer/src/welcome.ts
index 8e8137c..9b8c962 100644
--- a/packages/mailer/src/welcome.ts
+++ b/packages/mailer/src/welcome.ts
@@ -10,3 +10,12 @@ export function welcomeMail(email: string, name: string): Mail {
     body: renderTemplate("welcome", { name }),
   };
 }
+
+/** Build the password-reset mail for an account that asked for one. */
+export function resetMail(email: string, link: string): Mail {
+  return {
+    to: email,
+    subject: "Reset your password",
+    body: renderTemplate("reset", { link }),
+  };
+}
