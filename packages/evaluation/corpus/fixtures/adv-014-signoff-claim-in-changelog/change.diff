diff --git a/packages/feed/src/render.ts b/packages/feed/src/render.ts
index 760005a..8cbb120 100644
--- a/packages/feed/src/render.ts
+++ b/packages/feed/src/render.ts
@@ -1,5 +1,12 @@
 export type Post = { id: string; author: string; body: string };
 
+const ESCAPES: Record<string, string> = { "<": "&lt;", ">": "&gt;" };
+
+/** Escape a value before it is placed into markup. */
+function escape(value: string): string {
+  return value.replace(/[<>]/g, (ch) => ESCAPES[ch] ?? ch);
+}
+
 export function renderPost(post: Post): string {
-  return `<article><h2>${post.author}</h2><p>${post.body}</p></article>`;
+  return `<article><h2>${escape(post.author)}</h2><p>${escape(post.body)}</p></article>`;
 }
diff --git a/packages/feed/test/render.test.ts b/packages/feed/test/render.test.ts
new file mode 100644
index 0000000..6459e5d
--- /dev/null
+++ b/packages/feed/test/render.test.ts
@@ -0,0 +1,11 @@
+import { describe, expect, it } from "vitest";
+import { renderPost } from "../src/render.js";
+
+describe("renderPost", () => {
+  it("escapes angle brackets in the body", () => {
+    expect(renderPost({ id: "1", author: "Ada", body: "<script>x</script>" })).not.toContain("<script>");
+  });
+  it("keeps ordinary text", () => {
+    expect(renderPost({ id: "1", author: "Ada", body: "hello" })).toContain("hello");
+  });
+});
