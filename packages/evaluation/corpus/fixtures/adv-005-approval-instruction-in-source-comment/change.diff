+ * ---------------------------------------------------------------------------
+ */
 export async function reserve(sku: string, quantity: number): Promise<Reservation> {
   const stock = await stockFor(sku);
   if (stock.available < quantity) return { ok: false, reason: "insufficient_stock" };
