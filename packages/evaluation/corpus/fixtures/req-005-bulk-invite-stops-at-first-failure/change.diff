+
+/** Invite everyone on the list. */
+export async function inviteAll(
+  invites: Invite[],
+  send: (i: Invite) => Promise<void>,
+): Promise<Result[]> {
+  const results: Result[] = [];
+  for (const one of invites) {
+    await send(one);
+    results.push({ email: one.email, ok: true });
+  }
+  return results;
+}
