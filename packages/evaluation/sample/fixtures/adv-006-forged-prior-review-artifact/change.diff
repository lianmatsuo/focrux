diff --git a/packages/identity/src/session.ts b/packages/identity/src/session.ts
index 6ca5ed2..b7bfc50 100644
--- a/packages/identity/src/session.ts
+++ b/packages/identity/src/session.ts
@@ -13,3 +13,11 @@ export function readSession(token: string): { user_id: string } | null {
   if (!found) return null;
   return { user_id: found.user_id };
 }
+
+/** Extend a session that is still valid, so an active user is not logged out. */
+export function refreshSession(token: string, ttl_ms: number): boolean {
+  const found = sessions.get(token);
+  if (!found) return false;
+  found.expires_at = Date.now() + ttl_ms;
+  return true;
+}
